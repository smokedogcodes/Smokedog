{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sd-game",
  "main": "workers/game/main.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "alias": {
    "@": "./src"
  },
  "observability": { "enabled": true },
  "vars": {
    "ADMIN_USER": "admin"
  },
  "durable_objects": {
    "bindings": [
      { "name": "engineActor", "class_name": "EngineActor" },
      { "name": "socketActor", "class_name": "SocketActor" },
      { "name": "adminActor", "class_name": "AdminActor" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EngineActor", "SocketActor"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AdminActor"]
    }
  ]
}
