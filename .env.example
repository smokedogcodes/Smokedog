# Leave empty locally so the client uses the same origin (unified server.ts).
NEXT_PUBLIC_SOCKET_URL=

# Cloudflare production (set in wrangler.jsonc, not .env):
# NEXT_PUBLIC_SOCKET_URL=https://sd-game.smokedog.workers.dev
# UI: npm run deploy:cf
# Game: npm run deploy:cf:game

# Local split-mode testing (game server in a second terminal):
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Standalone game server process (local or self-hosted VM only)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Self-hosted game server CORS (comma-separated origins allowed):
# CORS_ORIGIN=https://sd.smokedog.workers.dev

# Admin panel (/admin) — set on the game worker (wrangler secret / vars)
ADMIN_USER=admin
# Production secret on sd-game worker (wrangler secret put ADMIN_PASSWORD):
ADMIN_PASSWORD=change-me-smokedog
# Prefer hashed password in production:
# ADMIN_PASSWORD_HASH=<salt:hex from hashAdminPassword()>
# ADMIN_SESSION_SECRET=<random>
