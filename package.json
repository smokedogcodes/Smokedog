{
  "name": "smokedog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "next start",
    "start:game": "tsx src/server/standalone.ts",
    "lint": "next lint",
    "build:cf": "npm run build && opennextjs-cloudflare build --skipNextBuild",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy",
    "deploy:cf:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cf-win.ps1",
    "deploy:cf:game": "wrangler deploy -c wrangler.game.jsonc",
    "deploy:cf:all": "npm run deploy:cf:game && npm run deploy:cf",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "tsx --test src/lib/games/exploding-kittens/reducer.test.ts src/lib/games/battleship/reducer.test.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.18.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@opennextjs/cloudflare": "^1.15.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "socket.io-serverless": "^0.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=18"
  }
}
